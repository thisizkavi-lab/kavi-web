<style>
  /* Light and dark only — hide the system/auto theme icon */
  #light-toggle-system {
    display: none !important;
  }
</style>
<script>
  (() => {
    document.querySelectorAll('link[rel="shortcut icon"], link[rel="icon"], link[rel="apple-touch-icon"]').forEach((link) => link.remove());
    const svg = document.createElement('link');
    svg.rel = 'icon';
    svg.type = 'image/svg+xml';
    svg.href = '{{ "/assets/img/favicon.svg" | relative_url }}';
    const png = document.createElement('link');
    png.rel = 'icon';
    png.type = 'image/png';
    png.sizes = '32x32';
    png.href = '{{ "/assets/img/kavi-favicon.png" | relative_url }}';
    const apple = document.createElement('link');
    apple.rel = 'apple-touch-icon';
    apple.href = '{{ "/assets/img/kavi-apple-touch.png" | relative_url }}';
    document.head.append(svg, png, apple);
  })();

  (() => {
    const sys = document.getElementById('light-toggle-system');
    if (sys) sys.remove();

    if (typeof toggleThemeSetting === 'function' && typeof setThemeSetting === 'function') {
      toggleThemeSetting = () => {
        const current =
          typeof determineThemeSetting === 'function' ? determineThemeSetting() : localStorage.getItem('theme');
        setThemeSetting(current === 'light' ? 'dark' : 'light');
      };
    }

    const setting = localStorage.getItem('theme');
    if (setting !== 'light' && setting !== 'dark' && typeof setThemeSetting === 'function') {
      const computed =
        typeof determineComputedTheme === 'function'
          ? determineComputedTheme()
          : document.documentElement.getAttribute('data-theme') || 'dark';
      setThemeSetting(computed === 'light' ? 'light' : 'dark');
    }
  })();
</script>
